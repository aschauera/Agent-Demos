# Token broker environment variables
# Copy to .env (gitignored) and fill in real values for local development.

# Copilot Studio Direct Line secret (Settings > Channels > Custom website > Secret keys)
DIRECTLINE_SECRET=

# Direct Line endpoint region: 'global' or 'europe' (use 'europe' for EU-region bots)
DIRECTLINE_REGION=global

# Azure AI Speech (Cognitive Services)
SPEECH_KEY=
SPEECH_REGION=westeurope

# CORS allow-list (comma separated). '*' for development only.
ALLOWED_ORIGINS=*

# Optional: comma-separated trusted origins embedded in the Direct Line token
TRUSTED_ORIGINS=

# Broker port (matches nginx upstream)
PORT=3000
